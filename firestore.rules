rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /games/{g} {
      function gameData() { return get(/databases/$(database)/documents/games/$(g)).data; }
      function isHost() { return signedIn() && gameData().host == request.auth.uid; }
      function myPlayer() { return /databases/$(database)/documents/games/$(g)/players/$(request.auth.uid); }

      // 게임 상태: 로그인한 누구나 읽기, 만든 교사만 수정
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.host == request.auth.uid;

      // 정답·레이스·전체 단서: 교사만
      match /secret/{d} {
        allow read, write: if isHost();
      }

      // 반별 공개 단서: 교사와 그 반 학생만 읽기
      match /classes/{c} {
        allow read: if isHost() || (signedIn() && exists(myPlayer()) && get(myPlayer()).data.cls == c);
        allow write: if isHost();
      }

      // 학생: 자기 문서만. 베팅 시간 안에서 이번 라운드 베팅(최대 maxBet칩, 기본 2)을 몇 번이든 바꿀 수 있음. 시작 칩은 startChips(기본 20)
      // 17칸 이상 들어간 말에는 베팅 금지
      match /players/{uid} {
        function validNew() {
          let d = request.resource.data;
          return d.keys().hasOnly(['cls', 'num', 'name', 'chips', 'bets', 'br', 'cur'])
            && d.chips == gameData().settings.get('startChips', 20) && d.br == 0
            && d.bets == [0, 0, 0, 0, 0, 0, 0, 0]
            && d.cur == [0, 0, 0, 0, 0, 0, 0, 0]
            && d.cls is string && d.cls.size() <= 10
            && d.num is int && d.num >= 1 && d.num <= 99
            && d.name is string && d.name.size() >= 1 && d.name.size() <= 12
            && gameData().status != 'end';
        }
        // 같은 라운드 안에서 다시 고르면, 전에 건 칩을 되돌린 뒤 새로 건다
        function prevCur(o, gm, i) { return o.br == gm.round ? o.cur[i] : 0; }
        function okHorse(n, o, gm, i) {
          return n.cur[i] is int && n.cur[i] >= 0
            && n.bets[i] == o.bets[i] - prevCur(o, gm, i) + n.cur[i]
            && (n.cur[i] == 0 || gm.pos[i] < 17);
        }
        function curSum(c) { return c[0] + c[1] + c[2] + c[3] + c[4] + c[5] + c[6] + c[7]; }
        function validBet() {
          let n = request.resource.data;
          let o = resource.data;
          let gm = gameData();
          let oldSum = o.br == gm.round ? curSum(o.cur) : 0;
          return n.diff(o).affectedKeys().hasOnly(['bets', 'chips', 'br', 'cur'])
            && gm.status == 'bet' && n.br == gm.round
            && n.bets.size() == 8 && n.cur.size() == 8
            && okHorse(n, o, gm, 0) && okHorse(n, o, gm, 1) && okHorse(n, o, gm, 2) && okHorse(n, o, gm, 3)
            && okHorse(n, o, gm, 4) && okHorse(n, o, gm, 5) && okHorse(n, o, gm, 6) && okHorse(n, o, gm, 7)
            && curSum(n.cur) <= gm.settings.get('maxBet', 2)
            && n.chips == o.chips + oldSum - curSum(n.cur) && n.chips >= 0;
        }
        allow read: if isHost() || (signedIn() && request.auth.uid == uid);
        allow create: if signedIn() && request.auth.uid == uid && validNew();
        allow update: if signedIn() && request.auth.uid == uid && validBet();
        allow delete: if isHost();
      }
    }
  }
}
